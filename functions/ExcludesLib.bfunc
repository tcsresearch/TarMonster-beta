#!/bin/env bash


function Find_ExcludedFiles() {
        ## find | grep -f "$(pwd)"/excludes-filtered2.list | tee ExcludedFiles.list
        find . -type f | grep -f "$(pwd)/excludes-filtered2.list" | tee ExcludedFiles.list

}


function Remove_ExcludedFiles() {
        xargs rm < ExcludedFiles.list
}

function ExcludesHandler() { # MultiFunction Call
        Find_ExcludedFiles
        Remove_ExcludedFiles
}
